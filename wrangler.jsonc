{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "game-stoppo",
  "compatibility_date": "2026-08-01",
  "routes": [{ "pattern": "stoppo.redhippo.app", "custom_domain": true }],

  // Assets-only Worker: no `main`, so Cloudflare serves the built game straight
  // from the edge with no Worker invocation and no server-side code at all.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },

  "observability": {
    "enabled": true,
  },
}
